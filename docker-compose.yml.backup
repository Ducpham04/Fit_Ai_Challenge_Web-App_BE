version: "3.8"
services:
  db:
    image: mysql:8.0
    container_name: fit_challenge_db
    restart: always
    environment:
      MYSQL_DATABASE: fit_challenge
      MYSQL_ROOT_PASSWORD: 123456
    ports:
      - "3306:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 5

  adminer:
    image: adminer
    container_name: fit_challenge_adminer
    restart: always
    ports:
      - "8081:8080"
    depends_on:
      - db

  app:
    build: .
    container_name: fit_challenge_app
    ports:
      - "8080:8080"
    depends_on:
      db:
        condition: service_healthy
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://db:3306/fit_challenge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: 123456
      SPRING_JPA_HIBERNATE_DDL_AUTO: update

volumes:
  db_data:
